# Environment Selector:
# - local       -> Local Workstation mode (compose.local.yaml Air hot-reload, default port 8080, DB port 5432)
# - dev         -> Dev Server mode (compose.prod.yaml compiled Distroless build, recommended port 8050)
# - uat         -> UAT Host Server mode (compose.prod.yaml compiled Distroless build, recommended port 8180)
# - production  -> Production mode (compose.prod.yaml compiled Distroless build)
APP_ENV=local

# Host ports exposed on your machine (Local: 8080 | Dev Server: 8050 | UAT Server: 8180)
PORT=8080
POSTGRES_PORT=5432

# PostgreSQL credentials (isolated per APP_ENV Docker project volume)
POSTGRES_USER=rental_app
POSTGRES_PASSWORD=rental_dev_secret
POSTGRES_DB=rental_cloth_db

# Direct host execution defaults (automatically overridden to @postgres:5432 & 0.0.0.0:8080 inside Docker)
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://rental_app:rental_dev_secret@127.0.0.1:5432/rental_cloth_db?sslmode=disable

# Security & CORS (Local: http://localhost:3000 | Dev: https://dev-rental-cloth.sutiphonglabs.com,http://localhost:3050 | UAT: https://uat-rental-cloth.sutiphonglabs.com,http://localhost:3100)
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=rental_sid
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# Cloudflare Turnstile secret key (defaults to local test key)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional Cloudflare Tunnel token (when set, compose.tunnel.yaml starts cloudflared automatically)
CLOUDFLARE_TUNNEL_TOKEN=
