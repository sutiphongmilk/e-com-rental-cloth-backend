# Environment Selector:
# - Set APP_ENV=production -> Docker uses compose.prod.yaml (hardened Distroless static binary build)
# - Any other value (e.g. local, development) -> Docker uses compose.local.yaml (local Air hot-reload mode)
APP_ENV=local

# Host ports exposed on your machine
PORT=8080
POSTGRES_PORT=5432

# PostgreSQL credentials (shared with compose.yaml)
POSTGRES_USER=rental_app
POSTGRES_PASSWORD=rental_dev_secret
POSTGRES_DB=rental_cloth_db

# Direct host execution defaults (automatically overridden to @postgres:5432 & 0.0.0.0:8080 inside Docker)
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://rental_app:rental_dev_secret@127.0.0.1:5432/rental_cloth_db?sslmode=disable

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=rental_sid
SESSION_TTL_HOURS=168
# Cloudflare Turnstile test secret key (always passes in local development)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
